{
  "name": "dg-operations-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "python3 scripts/serve.py",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "build:pages": "next build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "collect": "python3 scripts/collect.py --live",
    "collect:cached": "python3 scripts/collect.py",
    "publish:data": "python3 scripts/publish.py",
    "preview": "python3 scripts/serve.py"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "typescript": "5.9.3"
  },
  "type": "module"
}
